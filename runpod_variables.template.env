SAFETENSORS_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SAFETENSORS_PANEL_USER=CHANGE_ME_PANEL_USER
SAFETENSORS_PANEL_PASSWORD=CHANGE_ME_STRONG_PANEL_PASSWORD
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

SAFETENSORS_VOLUME_ROOT=/workspace
SAFETENSORS_MODELS_DIR=/workspace/models/safetensors
SAFETENSORS_STATE_DIR=/workspace/.state/safetensors-rig
SAFETENSORS_LOG_DIR=/workspace/logs/safetensors-rig
SAFETENSORS_STARTUP_LOG=/workspace/logs/safetensors-rig/startup.log
SAFETENSORS_API_HOST=0.0.0.0
SAFETENSORS_API_PORT=8000
SAFETENSORS_PANEL_HOST=0.0.0.0
SAFETENSORS_PANEL_PORT=7860
SAFETENSORS_PANEL_FIND_FREE_PORT=0
SAFETENSORS_MAX_AUDIO_UPLOAD_BYTES=104857600
# On the first start, download and run this model automatically. Later starts
# restore the saved active model and do not download it again.
SAFETENSORS_BOOTSTRAP_MODEL=nvidia/audio-flamingo-next-hf
SAFETENSORS_BOOTSTRAP_REVISION=main
SAFETENSORS_BOOTSTRAP_DTYPE=bf16
SAFETENSORS_BOOTSTRAP_MAX_MODEL_LEN=8192
SAFETENSORS_BOOTSTRAP_MAX_NUM_SEQS=64
SAFETENSORS_BOOTSTRAP_TENSOR_PARALLEL_SIZE=1
SAFETENSORS_BOOTSTRAP_GPU_MEMORY_UTILIZATION=0.90
SAFETENSORS_BOOTSTRAP_TRUST_REMOTE_CODE=0
SAFETENSORS_BOOTSTRAP_ENFORCE_EAGER=0
SAFETENSORS_BOOTSTRAP_ENABLE_CHUNKED_PREFILL=0
SAFETENSORS_BOOTSTRAP_AUTO_ADJUST_CONTEXT=1
SAFETENSORS_BOOTSTRAP_MAX_AUDIO_PER_PROMPT=1
# Optional overrides for a custom domain. With no override RunPod's proxy URL
# is generated from RUNPOD_POD_ID automatically.
SAFETENSORS_PUBLIC_API_URL=
SAFETENSORS_PUBLIC_PANEL_URL=
SAFETENSORS_HEALTH_TIMEOUT=600
SAFETENSORS_STOP_TIMEOUT=30
SAFETENSORS_SKIP_INSTALL=0
SAFETENSORS_ALLOW_INSECURE=0
SAFETENSORS_VENV_DIR=/workspace/.venvs/safetensors-rig
SAFETENSORS_VENV_SYSTEM_SITE_PACKAGES=1
SAFETENSORS_INSTALL_VLLM=auto
SAFETENSORS_EXPECTED_VLLM_VERSION=0.20.0
SAFETENSORS_VLLM_CONSTRAINTS=/workspace/safetensors-rig-source/constraints-vllm-afnext.txt
SAFETENSORS_UPGRADE_PIP=0
VLLM_PYTHON=/workspace/.venvs/safetensors-rig/bin/python
HF_HOME=/workspace/.hf
HF_HUB_CACHE=/workspace/.hf/hub
PYTHON_EXE=python3
